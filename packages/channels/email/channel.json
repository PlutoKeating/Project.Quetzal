{
  "id": "email",
  "displayName": "电子邮件",
  "transport": "smtp",
  "requiresCredentials": true,
  "longLived": false,
  "localOnly": false,
  "limits": {
    "maxInboundBytes": 10485760,
    "maxOutboundBytes": 1048576,
    "maxTextChars": 100000,
    "maxSubjectChars": 255,
    "maxAttachments": 20,
    "maxAttachmentBytes": 26214400
  },
  "desc": "电子邮件 RFC 5322：主题 255 字符、正文 100000 字符、附件 20 个；超限主题追加可见截断标记。"
}
