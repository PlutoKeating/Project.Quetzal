# Rust 构建产物
/target/

# Node / Web / 官网依赖与构建缓存
**/node_modules/
surfaces/web/dist/
website/build/
website/.wrangler/
website/.react-router/

# Go 二进制产物
hub/quetzalcoatl-hub
hub/cmd/quetzalcoatl-hub/quetzalcoatl-hub

# 原生桌面与移动端构建缓存
surfaces/macos/.build/
surfaces/macos/DerivedData/
surfaces/ios/DerivedData/
surfaces/windows/**/bin/
surfaces/windows/**/obj/
surfaces/windows/**/TestResults/
surfaces/windows/artifacts/
surfaces/android/.gradle/
surfaces/android/build/
surfaces/android/app/build/
surfaces/android/local.properties

# 本地 Agent 协作与工作树目录（不入库）
.superpowers/
.claude/worktrees/

# 环境变量与本地敏感配置（仅保留模板）
.env*
!.env.example
!**/.env.example

# 操作系统与编辑器临时文件
.DS_Store
*.swp
*.tmp

# UniFFI C# 冒烟生成物（脚本默认写入 target/，此处为手动运行兜底）
crates/bindings/quetzalcoatl-uniffi/tests/csharp_smoke/generated/
crates/bindings/quetzalcoatl-uniffi/tests/csharp_smoke/bin/
crates/bindings/quetzalcoatl-uniffi/tests/csharp_smoke/obj/

# Web 端 E2E 产物（Playwright）
surfaces/web/test-results/
surfaces/web/playwright-report/
surfaces/web/blob-report/

# Web 端可选 WASM 缓存宿主（由 scripts/build-web-wasm.sh 本地生成）
surfaces/web/public/wasm/
