#
# quetzalcoatl-hub 的 systemd 单元示例（不用容器的部署方式）。安装步骤见同目录 README.md。
#
#   二进制    /usr/local/bin/quetzalcoatl-hub
#   配置      /etc/quetzalcoatl-hub/hub.env      （由 hub.env.example 复制而来，root 所有，权限 0600）
#   数据      /var/lib/quetzalcoatl-hub          （systemd 自动创建，归运行用户所有）
#   运行用户  quetzalcoatl-hub                   （useradd --system 创建）

[Unit]
Description=Quetzalcoatl Hub (quetzalcoatl-hub)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quetzalcoatl-hub
Group=quetzalcoatl-hub
ExecStart=/usr/local/bin/quetzalcoatl-hub

# 数据目录固定为下面的 StateDirectory。hub.env 里若也设置了同名变量，以 hub.env 为准。
Environment=QUETZALCOATL_HUB_DATA_DIR=/var/lib/quetzalcoatl-hub
EnvironmentFile=/etc/quetzalcoatl-hub/hub.env
StateDirectory=quetzalcoatl-hub
StateDirectoryMode=0700
WorkingDirectory=/var/lib/quetzalcoatl-hub

Restart=on-failure
RestartSec=2
# 收到 SIGTERM 后 Hub 会先关闭中继与地址发现，再等在途请求结束（最多 10 秒）。
TimeoutStopSec=20
LimitNOFILE=65536

# 直出模式要监听 443 时，去掉下面两行的注释，并把再往下的 CapabilityBoundingSet= 一行删掉。
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=

# 加固：进程只需要读配置与证书、写自己的数据目录、收发网络包。
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
