# SPDX-License-Identifier: AGPL-3.0-only
#
# quetzalcoatl-hub 的全部环境变量。复制为 hub.env 后按需填写：
#
#   cp hub.env.example hub.env && chmod 600 hub.env
#
# 约定：
#   - 每行 `变量名=值`。值不要加引号，行尾不要写注释（compose 与 systemd 对它们的处理不一样）。
#   - 以 `#` 开头的变量行表示「不设置，用默认值」。
#   - 尖括号里的内容是占位符，必须整体换掉；原样留着会在启动时报错或认证失败，这是有意的。
#   - 「影响」写的是：改动这一项之后，谁会受到影响。
#   - hub.env 里有密钥，不要提交进任何仓库。


# ─────────────────────────── 监听与 TLS ───────────────────────────

# 说明：HTTP 服务监听的地址与端口。
# 默认：127.0.0.1:8443
# 影响：只影响这台机器上谁能连进来。用 compose 部署时由 compose.yaml 固定为 0.0.0.0:8443，
#       此处设置无效，对外范围改用 HUB_HTTP_PUBLISH 控制。
#QUETZALCOATL_HUB_ADDR=127.0.0.1:8443

# 说明：客户端访问这台 Hub 用的完整地址（协议 + 域名，必要时带端口），不带结尾斜杠。
#       密文包的上传下载链接按它签名，设备之间互相通告的中继地址也是它。
# 默认：http://<监听地址>，开启 TLS 时为 https://<监听地址>
# 影响：所有设备。它必须是客户端实际访问 Hub 的地址：填错时密文包传不上去也下不来，
#       通行密钥登录也会因来源不符被拒绝。改动后已登录的设备要改用新地址。
QUETZALCOATL_HUB_PUBLIC_URL=https://hub.example.com

# 说明：设为 1 或 true 时，HTTP 服务自己提供 HTTPS（直出模式）。
# 默认：关闭（明文 HTTP，交给前面的隧道或反向代理做 TLS）
# 影响：前面的隧道或反向代理要相应改成用 https 连 Hub。只设这一项而不给证书文件时，
#       用的是数据目录里自动生成的自签名证书，公网客户端不会信任它。
#QUETZALCOATL_HUB_TLS=1

# 说明：证书链与私钥文件（PEM）。两项必须同时设置；设置后 HTTP 服务自动改为 HTTPS，
#       地址发现（UDP）也用这张证书。
# 默认：不设置。此时地址发现用数据目录里自动生成的自签名证书，客户端默认不信任，
#       等于地址发现不可用。
# 影响：所有做地址发现的设备。证书要签给客户端访问中继所用的域名；续期后要重启 Hub
#       才会加载新证书。
#QUETZALCOATL_HUB_TLS_CERT_FILE=/certs/fullchain.pem
#QUETZALCOATL_HUB_TLS_KEY_FILE=/certs/privkey.pem


# ─────────────────────────── 数据与对象存储 ───────────────────────────

# 说明：数据目录。根密钥文件、自签名证书、SQLite 数据库与本地密文包都放在这里。
# 默认：$QUETZALCOATL_HOME/hub；没设 QUETZALCOATL_HOME 时是 ~/.quetzalcoatl/hub
# 影响：所有设备。指向一个空目录等于换了一台全新的 Hub：根密钥重新生成，
#       原有账户与数据全部不可见。用 compose 部署时固定为卷里的目录，此处设置无效。
#QUETZALCOATL_HUB_DATA_DIR=/var/lib/quetzalcoatl-hub

# 说明：Quetzalcoatl 的家目录，只用来推出上面数据目录的默认值。
# 默认：不设置
# 影响：同数据目录。已经显式设置了数据目录时这一项不起作用。
#QUETZALCOATL_HOME=/var/lib/quetzalcoatl

# 说明：SQLite 数据库文件路径。
# 默认：<数据目录>/hub.sqlite
# 影响：所有设备。换成别的文件等于换了一套账户与元数据。设置了 PostgreSQL 时不使用。
#QUETZALCOATL_HUB_SQLITE_PATH=/var/lib/quetzalcoatl-hub/hub.sqlite

# 说明：PostgreSQL 连接串。设置后改用 PostgreSQL，不再使用 SQLite。
# 默认：不设置（用 SQLite）
# 影响：所有设备。两种数据库之间没有自动迁移，切换等于换了一套账户与元数据。
#QUETZALCOATL_HUB_POSTGRES_DSN=postgres://quetzalcoatl:<数据库密码>@db.internal.example:5432/quetzalcoatl_hub?sslmode=require

# 说明：本地存放密文包的目录。
# 默认：<数据目录>/blobs
# 影响：所有设备。换目录后数据库里登记的密文包会找不到。设置了对象存储时不使用。
#QUETZALCOATL_HUB_BLOB_DIR=/var/lib/quetzalcoatl-hub/blobs

# 说明：S3 兼容对象存储的端点（Cloudflare R2、MinIO、AWS S3 等）。设置后密文包改存对象存储，
#       客户端直接向它上传下载。
# 默认：不设置（密文包存本地目录，经 Hub 上传下载）
# 影响：所有设备。本地目录与对象存储之间没有自动迁移；端点必须能被客户端直接访问。
#QUETZALCOATL_HUB_S3_ENDPOINT=https://<账号 ID>.r2.cloudflarestorage.com

# 说明：对象存储的区域。
# 默认：auto
# 影响：填错时所有上传下载的签名都会被对象存储拒绝。
#QUETZALCOATL_HUB_S3_REGION=auto

# 说明：存放密文包的桶名。
# 默认：无，使用对象存储时必填
# 影响：所有设备。换桶后数据库里登记的密文包会找不到。
#QUETZALCOATL_HUB_S3_BUCKET=<桶名>

# 说明：访问对象存储的密钥对。只需要对上面那个桶的读、写、删权限。
# 默认：无，使用对象存储时必填
# 影响：轮换后旧密钥签出的、尚未过期的上传下载链接会失效，客户端重试即可。
#QUETZALCOATL_HUB_S3_ACCESS_KEY_ID=<对象存储的 Access Key ID>
#QUETZALCOATL_HUB_S3_SECRET_ACCESS_KEY=<对象存储的 Secret Access Key>

# 说明：设为 1 时用路径风格地址（端点/桶/对象），MinIO 等自建对象存储通常需要。
# 默认：关闭（桶名作为子域名）
# 影响：填错时所有上传下载都会失败。
#QUETZALCOATL_HUB_S3_PATH_STYLE=1


# ─────────────────────────── 根密钥 ───────────────────────────
#
# 首次启动会自动生成这三把密钥并写入 <数据目录>/hub_secrets.json（权限 0600），
# 一般不需要在这里设置。只有想把密钥放在机密管理系统里、不落在数据目录时才用。
# 每项是 64 个十六进制字符（32 字节）；设置后优先于文件里的值。

# 说明：配对短码校验与本地密文包上传下载链接的签名密钥。
# 默认：取 hub_secrets.json 里的值
# 影响：进行中的配对与尚未过期的上传下载链接失效，重试即可；已有账户不受影响。
#QUETZALCOATL_HUB_HMAC_SECRET_HEX=<64 个十六进制字符>

# 说明：口令登录（OPAQUE）的服务端种子。
# 默认：取 hub_secrets.json 里的值
# 影响：所有用口令登录的账户。改动或丢失后，已注册的口令全部无法再登录，且无法恢复。
#QUETZALCOATL_HUB_OPRF_SEED_HEX=<64 个十六进制字符>

# 说明：口令登录（OPAQUE）的服务端私钥。
# 默认：取 hub_secrets.json 里的值
# 影响：同上，所有用口令登录的账户。
#QUETZALCOATL_HUB_OPAQUE_PRIVATE_SCALAR_HEX=<64 个十六进制字符>


# ─────────────────────────── 登录方式 ───────────────────────────

# 说明：通行密钥（Passkey）绑定的域名，填客户端访问 Hub 所用的域名。
# 默认：localhost
# 影响：所有用通行密钥登录的账户。通行密钥与这个域名绑定，改动后已注册的通行密钥全部失效。
QUETZALCOATL_HUB_RP_ID=hub.example.com

# 说明：允许发起通行密钥登录的来源，逗号分隔的完整地址。
# 默认：与 QUETZALCOATL_HUB_PUBLIC_URL 相同
# 影响：来源不在名单里的客户端无法用通行密钥注册或登录。
#QUETZALCOATL_HUB_ALLOWED_ORIGINS=https://hub.example.com

# 说明：口令登录（OPAQUE）里服务端的身份标识。
# 默认：server:quetzalcoatl-hub:v2
# 影响：所有用口令登录的账户。改动后已注册的口令全部无法再登录。除非明确知道后果，不要动。
#QUETZALCOATL_HUB_SERVER_IDENTITY=server:quetzalcoatl-hub:v2

# 说明：外部登录提供方（OIDC）的签发者地址与本 Hub 在它那里登记的客户端 ID。
# 默认：不设置（不启用外部登录）
# 影响：所有用外部账号登录的账户。账户按「签发者 + 用户标识」认人，换签发者等于全部变成新账户。
#QUETZALCOATL_HUB_OIDC_ISSUER=https://id.example.com
#QUETZALCOATL_HUB_OIDC_CLIENT_ID=<在登录提供方登记的客户端 ID>

# 说明：校验登录提供方签名用的公钥集合：JSON 对象，键是密钥 ID（kid），值是 PEM 公钥。
#       二选一，推荐用文件。Hub 不会联网去取公钥，提供方轮换密钥后要在这里更新并重启。
# 默认：不设置
# 影响：公钥过期或缺失时，所有外部账号登录都会被拒绝。
#QUETZALCOATL_HUB_OIDC_PUBKEYS_FILE=/etc/quetzalcoatl-hub/oidc-pubkeys.json
#QUETZALCOATL_HUB_OIDC_PUBKEYS_JSON=<一行 JSON：{"kid":"-----BEGIN PUBLIC KEY-----…"}>

# 说明：校验登录提供方「账户已注销」通知（发到 /v1/auth/events）用的公钥集合，格式同上。
# 默认：不设置（所有此类通知都被拒绝）
# 影响：持有对应私钥的一方可以让 Hub 删除指定外部账户的全部数据。只填登录提供方的公钥。
#QUETZALCOATL_HUB_WEBHOOK_PUBKEYS_FILE=/etc/quetzalcoatl-hub/auth-events-pubkeys.json
#QUETZALCOATL_HUB_WEBHOOK_PUBKEYS_JSON=<一行 JSON：{"kid":"-----BEGIN PUBLIC KEY-----…"}>


# ─────────────────────────── Webhook（IM 平台来信） ───────────────────────────
#
# 各平台把消息推到 /v1/webhook/<Agent>/<通道>，Hub 在内存里验签后立刻用设备公钥加密入队，
# 不落明文。没有配置密钥的通道一律拒收。

# 说明：各通道的验签密钥文件：JSON 对象，键是通道名（feishu、wecom、dingtalk、telegram、
#       email、webhook），值是该平台给的签名密钥。文件权限应为 0600。
# 默认：不设置
# 影响：对应通道的所有来信。密钥与平台侧不一致时来信全部被拒收。
#QUETZALCOATL_HUB_WEBHOOK_SECRETS_FILE=/etc/quetzalcoatl-hub/webhook-secrets.json

# 说明：单个通道的验签密钥，优先于上面文件里的同名通道。
# 默认：不设置（该通道拒收全部来信）
# 影响：对应通道的所有来信。
#QUETZALCOATL_HUB_WEBHOOK_SECRET_FEISHU=<飞书的签名密钥>
#QUETZALCOATL_HUB_WEBHOOK_SECRET_WECOM=<企业微信的签名密钥>
#QUETZALCOATL_HUB_WEBHOOK_SECRET_DINGTALK=<钉钉的签名密钥>
#QUETZALCOATL_HUB_WEBHOOK_SECRET_TELEGRAM=<Telegram 的签名密钥>
#QUETZALCOATL_HUB_WEBHOOK_SECRET_EMAIL=<邮件网关的签名密钥>
#QUETZALCOATL_HUB_WEBHOOK_SECRET_WEBHOOK=<通用 Webhook 的签名密钥>

# 说明：每个 Agent 最多积压多少条尚未被设备取走的来信。
# 默认：1024（填 0 或非法值时也按 1024）
# 影响：设备长期离线的 Agent。队列满了以后新的来信会被拒收，直到设备上线取走。
#QUETZALCOATL_HUB_WEBHOOK_QUEUE_PER_AGENT=1024


# ─────────────────────────── 配额 ───────────────────────────

# 说明：新建 Agent 的存储配额，单位字节。
# 默认：1073741824（1 GiB；填 0 或非法值时也按 1 GiB）
# 影响：只影响改动之后新建的 Agent；已有 Agent 的配额记在数据库里，不随它变化。
#QUETZALCOATL_HUB_AGENT_QUOTA_BYTES=1073741824


# ─────────────────────────── 地址发现 ───────────────────────────

# 说明：地址发现（QAD）的 UDP 监听地址。设备靠它得知自己的公网地址，才能互相直连。
#       填 off 关闭。这个端口必须从公网直接可达，HTTP 隧道与反向代理都转发不了它。
# 默认：:7842（全部网卡）
# 影响：所有设备。关闭或不可达时设备之间打不通直连，流量改走 Hub 中继，更慢也更占 Hub 带宽。
#       改端口后每台设备都要相应改 QUETZALCOATL_FABRIC_QAD_PORT。用 compose 部署时不要改这里，
#       改 HUB_QAD_PUBLISH。
#QUETZALCOATL_HUB_QAD_ADDR=:7842


# ─────────────────────────── 指标与元信息 ───────────────────────────

# 说明：访问 /metrics 的令牌。设置后必须带 `Authorization: Bearer <令牌>` 才能读指标；
#       长度 16 到 256 个字符，只能是不含空格的可见 ASCII。可用 `openssl rand -hex 32` 生成。
# 默认：不设置。此时 /metrics 只对本机回环地址的直连请求开放，经隧道、反向代理或容器端口
#       映射进来的请求一律得到 404。用容器部署时要读指标就必须设置它。
# 影响：只影响管理员自己的监控抓取。
#QUETZALCOATL_HUB_METRICS_TOKEN=<openssl rand -hex 32 的输出>

# 说明：允许连接的最低客户端版本，形如 2.0.0 或 2.0.0-alpha.4（不带 v 前缀）。
#       通过 /v1/meta 告诉客户端，由客户端自行提示升级或停止同步。
# 默认：不设置（空串，不设门槛）
# 影响：所有版本低于它的客户端。设得比已发布的最新版还高，会把所有人挡在外面。
#QUETZALCOATL_HUB_MIN_CLIENT_VERSION=2.0.0

# 说明：公告，一行纯文本，最多 500 字节（约 160 个汉字），不能含换行等控制字符。
#       通过 /v1/meta 下发，由客户端展示。
# 默认：不设置（空串，没有公告）
# 影响：所有客户端都会看到。它是公开的，不要写内部信息。
#QUETZALCOATL_HUB_ANNOUNCEMENT=本周六 02:00 至 03:00 维护，期间同步暂停
