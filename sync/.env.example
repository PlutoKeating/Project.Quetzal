# Quetzal 同步服务的配置。./start.sh 第一次运行时会复制为 .env（权限 600）并引导你填写；.env 不入库。

# 必填：同步服务的域名。caddy 模式下 DNS 的 A / AAAA 记录要指向这台服务器，Caddy 会自动申请 HTTPS 证书。
SYNC_DOMAIN=
# 对外方式：caddy（默认，本机的 80 / 443 由 Caddy 提供 HTTPS）或 tunnel（不用 80 / 443：同步服务只监听 127.0.0.1:SYNC_LOCAL_PORT，
# 由已有的反向隧道转发，例如 Cloudflare Tunnel 加一条 public hostname：SYNC_DOMAIN → http://localhost:SYNC_LOCAL_PORT）。
SYNC_FRONT=caddy
SYNC_LOCAL_PORT=8788
# STUN / TURN 用的主机名（或 IP）。留空则与 SYNC_DOMAIN 相同；tunnel 模式或 SYNC_DOMAIN 开了 CDN 代理时必填，且必须直连本机（DNS only）。
TURN_HOST=

# 网页前端（可选）：给人看的页面（登录、账户、批准身体）都放在这个站点上，例如 https://quetzal.plutokeating.beer。
# 留空则用同步服务自带的简单页面。前端必须与 SYNC_DOMAIN 同一个可注册域名（同站），会话 Cookie 才能随请求带上。
SYNC_WEB_URL=
# GitHub 登录（在 https://github.com/settings/applications/new 创建一个 OAuth App）：
#   Homepage URL                https://<SYNC_DOMAIN>
#   Authorization callback URL  https://<SYNC_DOMAIN>/auth/github/callback
# 不填则网页无法登录、身体无法绑定（信令与 TURN 仍然运行）。
# 服务器连 github.com 时通时断（例如中国大陆机房）时，GITHUB_OAUTH_RELAY 填一个换令牌的中转地址：直连失败才经它转发
# （本项目的官网 Worker 提供 https://quetzal.plutokeating.beer/api/oauth/github/token，只放行它的 OAUTH_CLIENT_IDS 变量里的 App）。
GITHUB_OAUTH_RELAY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 自动生成：同步服务与 coturn 共用的密钥，用来签发有时效的 TURN 凭据。不要泄露；更换后已发出的凭据立即失效。
TURN_SECRET=

# TURN 中转使用的 UDP 端口段（防火墙 / 云安全组要放行）。一个中转会话占一个端口。
TURN_MIN_PORT=49160
TURN_MAX_PORT=49250
# TURN 配额：每具身体同时最多几个中转分配；全服务器最多几个（不能超过上面端口段的端口数，start.sh 会检查）。
TURN_USER_QUOTA=4
TURN_TOTAL_QUOTA=90
# TURN 带宽（字节 / 秒，0 为不限）：每个中转会话的上限（默认约 5 Mbit/s），全部会话合计的上限（默认约 20 Mbit/s）。按服务器的带宽调整。
TURN_MAX_BPS=625000
TURN_BPS_CAPACITY=2500000

# 每个账户最多绑定几个 agent；每个 agent 最多几具身体。
SYNC_MAX_AGENTS_PER_USER=20
SYNC_MAX_BODIES_PER_AGENT=16

# 镜像与软件源。服务器拉不动 Docker Hub 或 npm 时，改成可用的镜像源（例如国内的 Docker 镜像加速地址、https://registry.npmmirror.com）。
# 镜像按 tag@sha256 摘要固定；换成镜像源的地址时保留 @sha256 部分（例如 <镜像源>/library/node:24-alpine@sha256:…），拉到的仍是同一份内容。
# 这三项保持官方地址时，./start.sh 会把它们跟到本仓库当前固定的摘要。
NODE_IMAGE=node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
CADDY_IMAGE=caddy:2.11.6-alpine@sha256:d44355d3c2149dc580ce2cac735955d1c08d3d00882c30489c241aa51a5c10d9
COTURN_IMAGE=coturn/coturn:4.18.0@sha256:bbefd3e1fdfdc0d58770fe01b581fd8b00d9f3a5580d00acb77cf719a6bc78e3
NPM_REGISTRY=https://registry.npmjs.org

# TURN 的中转地址：留空时 start.sh 自动探测（主网卡的 IPv4；网卡上是内网地址时再探测公网地址，写成 公网/内网 的映射）。服务器换了地址就清空它们再运行一次。
TURN_RELAY_IP=
TURN_EXTERNAL_IP=
# 由 start.sh 每次运行时写入（不用手改）：本机的公网 IPv4，coturn 禁止中转到它（同一台服务器上的其他服务不能借 TURN 从本机访问）。
TURN_PUBLIC_IP=
# 高级：放行 TURN 中转到某个内网地址（默认禁止中转到一切私有地址，防止借 TURN 打进服务器所在的内网）。只在确实需要时填写。
TURN_ALLOWED_PEER_IP=
