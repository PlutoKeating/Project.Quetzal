{
  "name": "quetzalcoatl-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Quetzalcoatl product site: React Router (prerendered static pages) + a Cloudflare Worker for signed release mirroring",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "gen:install": "node scripts/gen-install-bundle.mjs",
    "predev": "npm run gen:install",
    "dev": "react-router dev",
    "prebuild": "npm run gen:install",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "wrangler dev",
    "pretypecheck": "npm run gen:install",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run gen:install",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
