{
  "name": "windler-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Windler 产品官网：React Router（预渲染为静态站）+ Tailwind CSS，部署在 Cloudflare Workers 静态资源",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "tokens": "node --experimental-strip-types --no-warnings scripts/gen-tokens.ts",
    "lint:tokens": "node --experimental-strip-types --no-warnings scripts/lint-tokens.ts",
    "typecheck": "react-router typegen && tsc",
    "prebuild": "npm run tokens && npm run lint:tokens",
    "build": "react-router build && npx pagefind --site build/client && node scripts/postbuild.mjs",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.19.0",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "unist-util-visit": "^5.1.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
