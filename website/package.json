{
  "name": "windler-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Windler 产品官网：React Router（预渲染为静态站）+ Tailwind CSS，部署在 Cloudflare Workers 静态资源",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "tokens": "node --experimental-strip-types --no-warnings scripts/gen-tokens.ts",
    "lint:tokens": "node --experimental-strip-types --no-warnings scripts/lint-tokens.ts",
    "typecheck": "react-router typegen && tsc",
    "prebuild": "npm run tokens && npm run lint:tokens",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "isbot": "^5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
