<Project Sdk="Microsoft.NET.Sdk">

  <!--
    生成的 C# 绑定（uniffi-bindgen-cs）编译冒烟工程。
    生成目录与中间产物目录通过 MSBuild 属性注入，仓库内不落地任何生成物/构建产物：
      dotnet run (project: Consumer.csproj, 传入 QzGeneratedDir/BaseIntermediateOutputPath/BaseOutputPath)
    生成的胶水代码包含 FFI 指针搬运，需要 AllowUnsafeBlocks（仅限生成代码）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>QuetzalcoatlCsharpSmoke</AssemblyName>
    <RootNamespace>Quetzalcoatl.Smoke</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <QzGeneratedDir Condition="'$(QzGeneratedDir)' == ''">$(MSBuildThisFileDirectory)generated</QzGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(QzGeneratedDir)/*.cs" />
  </ItemGroup>

</Project>
