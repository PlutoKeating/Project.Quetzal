# 安卓内置运行环境的锁定版本。改动后重新运行 build-packages.sh 与 pack.sh。
TERMUX_PACKAGES_COMMIT=ce59c5eac46c528aabdd5348b050c7fd64bacdb6
APP_PACKAGE=xyz.quetzal.console
ARCHES="aarch64"
PACKAGES="nodejs-lts git openssh proot"
# 打进 jniLibs 的可执行文件（前缀里的相对路径）。与 git 内容相同的内置子命令自动保留为链接；其余可执行文件（sshd、git 的 http 推送 / 守护进程、Kerberos 工具……）不打包
EXEC_KEEP="bin/node bin/git libexec/git-core/git libexec/git-core/git-remote-http bin/ssh bin/ssh-keygen bin/proot libexec/proot/loader libexec/proot/loader32"
