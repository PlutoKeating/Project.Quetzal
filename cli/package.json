{
  "name": "windler",
  "version": "0.4.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Windler：让 agent 像生命一样活着的运行基座。npx windler 把它装到这台 Linux 机器上并交给 systemd 守护",
  "homepage": "https://windler.plutokeating.beer",
  "repository": { "type": "git", "url": "git+https://github.com/PlutoKeating/Project.Windler.git", "directory": "cli" },
  "keywords": ["agent", "windler", "runtime", "linux"],
  "bin": { "windler": "dist/windler.mjs" },
  "files": ["dist"],
  "os": ["linux"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc --noEmit && tool/bundle-runtime.sh && esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --banner:js='#!/usr/bin/env node' --outfile=dist/windler.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
