{
  "name": "@quetzalcoatl/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quetzalcoatl 治理面（Web）：只有看和签",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "preview": "node build.mjs && node e2e/mock-daemon.mjs --port 43117 --static dist",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
