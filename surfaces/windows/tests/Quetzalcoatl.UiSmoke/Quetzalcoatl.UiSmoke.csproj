<Project Sdk="Microsoft.NET.Sdk">

  <!--
    外部 UI Automation 冒烟客户端（WPF 自带 UIAutomationClient）。
    必须与 Quetzalcoatl.App 运行在同一个交互式会话中；无桌面会话时返回 77（SKIP）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <RootNamespace>Quetzalcoatl.UiSmoke</RootNamespace>
    <AssemblyName>Quetzalcoatl.UiSmoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Quetzalcoatl.Desktop/Quetzalcoatl.Desktop.csproj" />
  </ItemGroup>

</Project>
