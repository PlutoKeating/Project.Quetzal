<Project>

  <!--
    Quetzalcoatl Windows 桌面端统一编译门禁：
      * Nullable=enable / TreatWarningsAsErrors=true —— 与 AGENTS.md 第 4.6 条一致；
      * NET 分析器暂不启用：Windows 验证只在 CI 的 windows 任务里进行，盲开 CAxxxx 规则会让
        「警告即错误」门禁在无法本地复验时变红。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 允许在有更新主版本运行时的机器上运行（宿主 .NET 10 可跑 net9.0 单测）。 -->
    <RollForward>LatestMajor</RollForward>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    WindowsAppSDK 的 MRT/PRI 与 payload 目标需要 VS Build Tools 的 AppxPackage MSBuild 任务。
    用 `dotnet build` 时 `$(MSBuildExtensionsPath)` 指向 .NET SDK 目录，因此这里在常见的
    VS 安装位置里探测 `Microsoft.Build.AppxPackage.dll`（2022 的 BuildTools/Community/
    Professional/Enterprise/Preview，Program Files 与 Program Files (x86) 两个根，以及 2019）。
    第一个命中的位置写入 AppxMSBuildToolsPath；全部缺失时由 App 工程的
    `QzRequireAppxMsBuildTools` 目标给出可操作的错误。
  -->
  <PropertyGroup>
    <_QzAppxRel>MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_QzAppxRel>
    <_QzAppxRel2019>MSBuild\Microsoft\VisualStudio\v16.0\AppxPackage\</_QzAppxRel2019>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\BuildTools\$(_QzAppxRel)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\BuildTools\$(_QzAppxRel)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\Community\$(_QzAppxRel)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\Community\$(_QzAppxRel)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\Professional\$(_QzAppxRel)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\Professional\$(_QzAppxRel)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\Enterprise\$(_QzAppxRel)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\Enterprise\$(_QzAppxRel)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\Preview\$(_QzAppxRel)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\Preview\$(_QzAppxRel)</AppxMSBuildToolsPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\BuildTools\$(_QzAppxRel)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(ProgramFiles)\Microsoft Visual Studio\2022\BuildTools\$(_QzAppxRel)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Community\$(_QzAppxRel)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(ProgramFiles)\Microsoft Visual Studio\2022\Community\$(_QzAppxRel)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Professional\$(_QzAppxRel)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(ProgramFiles)\Microsoft Visual Studio\2022\Professional\$(_QzAppxRel)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Enterprise\$(_QzAppxRel)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(ProgramFiles)\Microsoft Visual Studio\2022\Enterprise\$(_QzAppxRel)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Preview\$(_QzAppxRel)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(ProgramFiles)\Microsoft Visual Studio\2022\Preview\$(_QzAppxRel)</AppxMSBuildToolsPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2019\BuildTools\$(_QzAppxRel2019)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\2019\BuildTools\$(_QzAppxRel2019)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2019\Community\$(_QzAppxRel2019)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\2019\Community\$(_QzAppxRel2019)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2019\Professional\$(_QzAppxRel2019)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\2019\Professional\$(_QzAppxRel2019)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2019\Enterprise\$(_QzAppxRel2019)Microsoft.Build.AppxPackage.dll')">
    <AppxMSBuildToolsPath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\2019\Enterprise\$(_QzAppxRel2019)</AppxMSBuildToolsPath>
  </PropertyGroup>

</Project>
