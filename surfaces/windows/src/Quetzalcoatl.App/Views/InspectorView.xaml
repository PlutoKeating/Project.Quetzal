<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Quetzalcoatl.App.Views.InspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" ColumnSpacing="20" RowSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.ColumnSpan="2"
            FontSize="26"
            FontWeight="SemiBold"
            Text="检视" />

        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
            <TextBlock FontSize="15" Opacity="0.8" Text="良知锁定正文（两层式稳态）" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock
                    AutomationProperties.AutomationId="inspector.conscience"
                    FontFamily="Consolas"
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    Text="{Binding ConscienceBody}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
            <TextBlock FontSize="15" Opacity="0.8" Text="工具调用" />
            <ListView
                AutomationProperties.AutomationId="inspector.tools"
                AutomationProperties.Name="工具调用列表"
                ItemsSource="{Binding Tools}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4" Spacing="2">
                            <TextBlock FontFamily="Consolas" FontSize="12" Text="{Binding Summary}" TextWrapping="Wrap" />
                            <TextBlock FontFamily="Consolas" FontSize="11" Opacity="0.7" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
            <TextBlock FontSize="15" Opacity="0.8" Text="审计事件" />
            <ListView
                AutomationProperties.AutomationId="inspector.audit"
                AutomationProperties.Name="审计事件列表"
                ItemsSource="{Binding AuditRows}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Margin="0,3"
                            FontFamily="Consolas"
                            FontSize="12"
                            Text="{Binding Summary}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
            <TextBlock FontSize="15" Opacity="0.8" Text="运行技术日志（只在本页出现）" />
            <ListView
                AutomationProperties.AutomationId="inspector.technical"
                AutomationProperties.Name="运行技术日志"
                ItemsSource="{Binding TechnicalLog}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Margin="0,3"
                            FontFamily="Consolas"
                            FontSize="12"
                            Text="{Binding}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                AutomationProperties.AutomationId="inspector.pump"
                FontFamily="Consolas"
                FontSize="11"
                Opacity="0.7"
                Text="{Binding PumpSummary}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
