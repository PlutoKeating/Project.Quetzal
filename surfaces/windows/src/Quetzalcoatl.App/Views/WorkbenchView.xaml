<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Quetzalcoatl.App.Views.WorkbenchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.ColumnSpan="2"
            FontSize="26"
            FontWeight="SemiBold"
            Text="工作台" />

        <Grid Grid.Row="1" Grid.Column="0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="15" Opacity="0.8" Text="当前对话" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <TextBlock
                    AutomationProperties.AutomationId="workbench.transcript"
                    FontSize="16"
                    IsTextSelectionEnabled="True"
                    Text="{Binding Transcript}"
                    TextWrapping="Wrap" />
            </ScrollViewer>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Margin="0,2"
                            FontSize="13"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Text="{Binding}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ComposerBox"
                    AutomationProperties.AutomationId="workbench.entry"
                    AutomationProperties.Name="工作台输入框"
                    MinHeight="40"
                    PlaceholderText="继续说明，或粘贴要处理的材料"
                    KeyDown="OnComposerKeyDown"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.AutomationId="workbench.send"
                    AutomationProperties.Name="工作台发送按钮"
                    Click="OnSendClick"
                    Content="发送"
                    MinHeight="40"
                    MinWidth="96" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock FontSize="15" Opacity="0.8" Text="运行中的工作流" />
                <ListView
                    AutomationProperties.AutomationId="workbench.workflows"
                    AutomationProperties.Name="工作流列表"
                    ItemsSource="{Binding Workflows}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6" Spacing="2">
                                <TextBlock FontSize="14" Text="{Binding Summary}" TextWrapping="Wrap" />
                                <TextBlock FontSize="12" Opacity="0.7" Text="{Binding Detail}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock FontSize="15" Opacity="0.8" Text="等待你确认的操作" />
                <ListView
                    AutomationProperties.AutomationId="workbench.approvals"
                    AutomationProperties.Name="待批准操作列表"
                    ItemsSource="{Binding Approvals}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6" Spacing="6">
                                <TextBlock FontSize="14" Text="{Binding Summary}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="{Binding Key, Converter={StaticResource RowAutomationId}, ConverterParameter=workbench.approve}"
                                        AutomationProperties.Name="批准这项操作"
                                        Click="OnApproveClick"
                                        Content="批准"
                                        Tag="{Binding Key}" />
                                    <Button
                                        AutomationProperties.AutomationId="{Binding Key, Converter={StaticResource RowAutomationId}, ConverterParameter=workbench.deny}"
                                        AutomationProperties.Name="拒绝这项操作"
                                        Click="OnDenyClick"
                                        Content="拒绝"
                                        Tag="{Binding Key}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
