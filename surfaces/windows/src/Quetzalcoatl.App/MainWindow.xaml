<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Quetzalcoatl.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 取值来自 Quetzalcoatl 设计系统（packages/design-system/tokens）：纯黑底、白字，唯一的实色是白色主按钮。 -->
    <Grid Background="#000000" RequestedTheme="Dark">
    <StackPanel
        Padding="32"
        Spacing="16"
        MaxWidth="520"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <TextBlock
            Text="Quetzalcoatl"
            FontSize="26"
            FontWeight="Medium"
            Foreground="#FFFFFF" />
        <TextBlock
            Text="治理面在 Web 与 Linux 上；在终端运行 qz open。"
            Foreground="#8A8A8A"
            TextWrapping="Wrap" />
        <Button
            x:Name="OpenGovernanceButton"
            Content="打开本机治理面"
            AutomationProperties.Name="打开本机治理面"
            Background="#FFFFFF"
            Foreground="#000000"
            BorderThickness="0"
            CornerRadius="5"
            Padding="18,9"
            FontWeight="Medium"
            Click="OnOpenGovernance">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E0FFFFFF" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#000000" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E0FFFFFF" />
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#000000" />
            </Button.Resources>
        </Button>
        <TextBlock
            x:Name="StatusText"
            Foreground="#A3A3A3"
            TextWrapping="Wrap" />
    </StackPanel>
    </Grid>
</Window>
