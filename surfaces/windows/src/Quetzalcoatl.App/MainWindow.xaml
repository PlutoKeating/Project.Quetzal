<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Quetzalcoatl.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel
        Padding="32"
        Spacing="16"
        MaxWidth="520"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <TextBlock
            Text="Quetzalcoatl"
            Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
            Text="治理面在 Web 与 Linux 上；在终端运行 qz open。"
            TextWrapping="Wrap" />
        <Button
            x:Name="OpenGovernanceButton"
            Content="打开本机治理面"
            AutomationProperties.Name="打开本机治理面"
            Click="OnOpenGovernance" />
        <TextBlock
            x:Name="StatusText"
            TextWrapping="Wrap" />
    </StackPanel>
</Window>
