<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Quetzalcoatl.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Quetzalcoatl.App.Views"
    Title="Quetzalcoatl">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Padding="0">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnCompanionAccelerator" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnWorkbenchAccelerator" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnInspectorAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView
            x:Name="DensityTabs"
            AutomationProperties.AutomationId="nav.density"
            AutomationProperties.Name="视图密度"
            IsAddTabButtonVisible="False"
            CanReorderTabs="False"
            SelectionChanged="OnDensitySelectionChanged">

            <TabViewItem
                x:Name="CompanionTab"
                Header="陪伴"
                Tag="Companion"
                IsClosable="False"
                AutomationProperties.AutomationId="tab.companion"
                AutomationProperties.Name="陪伴视图（Ctrl+1）">
                <views:CompanionView x:Name="Companion" />
            </TabViewItem>

            <TabViewItem
                x:Name="WorkbenchTab"
                Header="工作台"
                Tag="Workbench"
                IsClosable="False"
                AutomationProperties.AutomationId="tab.workbench"
                AutomationProperties.Name="工作台视图（Ctrl+2）">
                <views:WorkbenchView x:Name="Workbench" />
            </TabViewItem>

            <TabViewItem
                x:Name="InspectorTab"
                Header="检视"
                Tag="Inspector"
                IsClosable="False"
                AutomationProperties.AutomationId="tab.inspector"
                AutomationProperties.Name="检视视图（Ctrl+3）">
                <views:InspectorView x:Name="Inspector" />
            </TabViewItem>
        </TabView>

        <Border
            Grid.Row="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
            <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock
                    x:Name="ConnectionStatusText"
                    AutomationProperties.AutomationId="status.connection"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="13"
                    Text="{Binding StatusText}" />
                <TextBlock
                    AutomationProperties.AutomationId="status.degraded"
                    FontSize="12"
                    Opacity="0.8"
                    Text="{Binding DegradedDetail}"
                    TextWrapping="Wrap"
                    Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
