<?xml version="1.0" encoding="utf-8"?>
<!--
  WinUI 3 需要 Microsoft.WindowsAppSDK / Microsoft.Windows.SDK.BuildTools，
  测试工程需要 Microsoft.NET.Test.Sdk + xunit。仅使用官方 nuget.org 源，
  不引入任何第三方或私有源。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
